# Copy to .env.local. Every value is optional in development.

# Public URL (used for metadata and links)
SITE_URL=http://localhost:3600

# Live payment gateway: leave empty to use the built-in test gateway (/pay/test/<order>)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
# Register <SITE_URL>/api/webhooks/payments in the gateway dashboard (payment.captured, order.paid, payment.failed)
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Allow the test gateway in production (staging only!)
ALLOW_TEST_PAYMENTS=false

# Where db.json lives (default ./data)
DATA_DIR=

# "Continue with Google". Authorised redirect URI: <SITE_URL>/api/auth/google/callback
# Signs in the account with that verified email, or creates one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin of the kit style guide allowed to embed Pro previews (defaults to http://localhost:3500 in development)
STYLEGUIDE_ORIGIN=
