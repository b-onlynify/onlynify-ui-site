{
  "name": "onlynify-ui-site",
  "version": "1.0.0",
  "private": true,
  "description": "ui.onlynify.com — docs, components, free and premium blocks, licences and payments for Onlynify UI",
  "scripts": {
    "sync": "node scripts/sync-ui.mjs && node scripts/extract-components.mjs && node scripts/export-styleguide-catalog.ts",
    "predev": "npm run sync",
    "dev": "next dev -p 3600",
    "prebuild": "npm run sync",
    "build": "next build",
    "start": "next start -p 3600",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/lib.test.ts tests/themes-sites.test.ts tests/pro-components.test.ts",
    "check:generated": "node scripts/check-generated.ts && tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.29",
    "onlynify-ui": "file:../onlynify-ui",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
